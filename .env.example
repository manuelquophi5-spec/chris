# Copy to .env.local (local) or set in Vercel -> Project Settings -> Environment Variables.

# MongoDB Atlas connection string. In Atlas -> Network Access, allow your host's IP
# (for Vercel serverless, 0.0.0.0/0 is the usual choice since egress IPs vary).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ug_attend?retryWrites=true&w=majority

# Secret used to sign session and QR tokens. At least 32 characters, random, never committed.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# NOTE: changing it signs everyone out and invalidates every printed class QR.
JWT_SECRET=

# Optional
# Institution name shown in the admin sidebar (default: University of Ghana).
SCHOOL_NAME=University of Ghana
# Student session length (default set in lib/constants.ts).
# JWT_EXPIRES_IN=7d
# Force Secure cookies when hosting on HTTPS outside Vercel (Vercel is detected automatically).
# COOKIE_SECURE=true
# Campus timezone as minutes UTC is ahead of local time (JS getTimezoneOffset). Ghana = 0 (default).
# CAMPUS_TZ_OFFSET_MINUTES=0
